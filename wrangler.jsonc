{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sami",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "6309c874-3219-4044-a3f0-b40b7ec47120","database_name": "sami" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "4752d30366104ffdaa7b3a0c105b310c" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
